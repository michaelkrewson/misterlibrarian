// The Librarian's Regimen on its own subdomain (m8k.io umbrella, 2026-10-10).
// Same pattern as cf/west.wrangler.jsonc: static-assets Worker, .html URLs kept
// (html_handling "none"), static-site.js serves index.html for "/" paths.
// Deploy: bash tools/deploy_blogs.sh regimen   (CI does this on push to main)
{
  "name": "m8k-regimen",
  "main": "static-site.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "regimen.m8k.io", "custom_domain": true }],
  "workers_dev": false,
  // Agorai launch (2026-10-14): which redirect map static-site.js uses.
  "vars": { "BLOG": "regimen" },
  "assets": {
    "binding": "ASSETS",
    "directory": "../health",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
