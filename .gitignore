# Private archive of upstream original-language sources (Mechon-Mamre Hebrew,
# SBLGNT Greek). NEVER committed — this repo is public (GitHub Pages); the
# archive is private-by-design. Durable copy lives in S3 blobs/bible_sources/.
# See tools/archive_sources.py.
source/originals/
__pycache__/
.DS_Store

# Claude Code session worktrees — never commit (a worktree dir is a gitlink,
# which makes GitHub Pages checkout fail: "No url found for submodule path")
.claude/worktrees/

# Per-chapter extraction dumps and build handoff notes. ROM8_greek.json (a whole
# chapter of the SBLGNT) and ROM8_STATE.md were committed here by accident on
# 2026-07-31 -- this repo is public, and extracted source text belongs in
# source/originals/ (already ignored) or the private S3 archive, never here.
*_STATE.md
*_greek.json
*_heb.json

# Cached shelf-version chapters from wol.jw.org (tools/shelf_text.py).
# Third-party copyrighted translations, fetched on demand and quoted in short
# phrases only -- never committed, never redistributed.
source/shelf/
